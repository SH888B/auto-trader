{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "plan.json —— Judge 次日交易计划契约（j0.2，E005：首分模式+trader 无脑执行单）",
  "type": "object",
  "required": ["date", "confidence", "market_view", "actions", "kill_switch"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "market_view": { "type": "string", "minLength": 4 },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ts_code", "name", "action", "price", "position_pct", "stop_loss", "take_profit", "reason", "thesis_tag"],
        "properties": {
          "ts_code": { "type": "string", "pattern": "^\\d{6}\\.(SH|SZ|BJ)$" },
          "name": { "type": "string", "minLength": 1 },
          "action": { "enum": ["buy", "hold", "avoid", "sell"] },
          "price": { "type": "number", "minimum": 0 },
          "position_pct": { "type": "number", "minimum": 0, "maximum": 0.5 },
          "stop_loss": { "type": ["number", "null"], "minimum": 0 },
          "take_profit": { "type": ["number", "null"], "minimum": 0 },
          "reason": { "type": "string", "minLength": 8 },
          "thesis_tag": { "enum": ["首分-20cm核心", "首分-20cm后排", "持仓改单", "空间板", "抱团观察", "防守", "其他"] }
        }
      }
    },
    "kill_switch": { "type": "string" }
  }
}
