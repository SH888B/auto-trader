{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Run event v1",
  "type": "object",
  "required": ["timestamp", "run_id", "module", "event", "status"],
  "properties": {
    "timestamp": {"type": "string"}, "run_id": {"type": "string"},
    "experiment_id": {"type": ["string", "null"]}, "arm_id": {"type": ["string", "null"]},
    "as_of": {"type": ["string", "null"]},
    "module": {"enum": ["scout", "curator", "judge", "trader", "broker", "evaluator"]},
    "event": {"enum": ["start", "end", "error"]},
    "status": {"enum": ["running", "success", "failed", "cancelled"]},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cost": {"type": ["number", "null"], "minimum": 0},
    "query_count": {"type": ["integer", "null"], "minimum": 0},
    "artifact_path": {"type": ["string", "null"]}, "error": {"type": ["string", "null"]}
  }
}
