{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Run input manifest v1",
  "type": "object",
  "required": ["manifest_version", "run_id", "module", "as_of", "inputs", "queries"],
  "properties": {
    "manifest_version": {"type": "string"}, "run_id": {"type": "string"},
    "module": {"enum": ["scout", "curator", "judge", "trader", "broker", "evaluator"]},
    "as_of": {"type": "string"},
    "inputs": {"type": "array", "items": {"type": "object"}},
    "queries": {"type": "array", "items": {"type": "object"}},
    "digest": {"type": "object"}, "gaps": {"type": "array", "items": {"type": "string"}}
  }
}
